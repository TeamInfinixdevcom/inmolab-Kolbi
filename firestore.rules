rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : null;
    }

    function isAdmin() { return role() == 'ADMIN'; }
    function isSupervisor() { return role() == 'SUPERVISOR'; }
    function isAgent() { return role() == 'AGENTE'; }
    function isStaff() { return isAdmin() || isSupervisor(); }
    function hasRole() { return isAdmin() || isSupervisor() || isAgent(); }
    function ownsExisting() {
      return resource.data.createdBy == request.auth.uid;
    }
    function createsAsSelf() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function updatesAsSelf() {
      return request.resource.data.updatedBy == request.auth.uid;
    }
    function agentUpdate() {
      return isAgent()
        && ownsExisting()
        && updatesAsSelf()
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    function isTaskRecord(data) {
      return data.keys().hasAny(['recordType']) && data.recordType == 'task';
    }
    function validTaskRecord(data) {
      return isTaskRecord(data)
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.description is string
        && data.description.size() <= 5000
        && data.status in ['Pendiente', 'En progreso', 'Completada']
        && data.priority in ['Baja', 'Media', 'Alta']
        && data.responsible is string
        && data.responsible.size() <= 200
        && data.responsibleId is string
        && data.responsibleId.size() > 0
        && exists(/databases/$(database)/documents/inmobiliarios/$(data.responsibleId))
        && data.dueDate is string
        && data.dueDate.size() <= 10
        && (data.dueDate == '' || data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && data.history is list;
    }
    function taskHistoryIsPreserved() {
      return resource.data.history is list
        && request.resource.data.history is list
        && request.resource.data.history.size() >= resource.data.history.size()
        && request.resource.data.history.hasAll(resource.data.history);
    }
    function assignedAgentTaskUpdate() {
      return isAgent()
        && isTaskRecord(resource.data)
        && validTaskRecord(request.resource.data)
        && isTaskRecord(request.resource.data)
        && taskHistoryIsPreserved()
        && resource.data.responsibleId == request.auth.uid
        && request.resource.data.responsibleId == resource.data.responsibleId
        && request.resource.data.createdBy == resource.data.createdBy
        && updatesAsSelf()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'description',
          'status',
          'priority',
          'dueDate',
          'history',
          'updatedAt',
          'updatedBy',
          'updatedById',
          'updatedByName'
        ]);
    }
    function validEventRecord(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 160
        && data.kind in ['Reunión', 'Visita', 'Llamada', 'Seguimiento']
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.time is string
        && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.status in ['Pendiente', 'Completado', 'Cancelado']
        && data.responsible is string
        && data.responsible.size() <= 200
        && data.responsibleId is string
        && data.responsibleId.size() <= 128
        && (data.responsibleId == ''
          || exists(/databases/$(database)/documents/inmobiliarios/$(data.responsibleId)))
        && data.client is string
        && data.client.size() <= 120
        && data.property is string
        && data.property.size() <= 200
        && data.notes is string
        && data.notes.size() <= 5000
        && (!data.keys().hasAny(['description'])
          || (data.description is string && data.description.size() <= 5000))
        && (!data.keys().hasAny(['participantIds'])
          || (data.participantIds is list && data.participantIds.size() <= 30))
        && (!data.keys().hasAny(['participantNames'])
          || (data.participantNames is list && data.participantNames.size() <= 30));
    }
    function assignedUserExists() {
      return request.resource.data.assignedTo is string
        && (
          (exists(/databases/$(database)/documents/users/$(request.resource.data.assignedTo))
            && get(/databases/$(database)/documents/users/$(request.resource.data.assignedTo)).data.role in ['ADMIN', 'SUPERVISOR', 'AGENTE'])
          || (exists(/databases/$(database)/documents/inmobiliarios/$(request.resource.data.assignedTo))
            && get(/databases/$(database)/documents/inmobiliarios/$(request.resource.data.assignedTo)).data.role in ['ADMIN', 'SUPERVISOR', 'AGENTE'])
        );
    }
    function createdByStaff() {
      return exists(/databases/$(database)/documents/users/$(resource.data.createdBy))
        && get(/databases/$(database)/documents/users/$(resource.data.createdBy)).data.role in ['ADMIN', 'SUPERVISOR'];
    }
    match /inmobiliarios/{id} {
      allow read: if hasRole();
      allow create, update, delete: if isAdmin();
    }

    match /propiedades/{id} {
      allow read: if hasRole();
      allow create: if (isStaff() || isAgent()) && createsAsSelf();
      allow update: if isStaff() && updatesAsSelf() || agentUpdate();
      allow delete: if isAdmin();
    }

    match /clientes/{id} {
      allow read: if hasRole();
      allow create: if (isStaff() || isAgent()) && createsAsSelf();
      allow update: if isStaff() && updatesAsSelf() || agentUpdate();
      allow delete: if isAdmin();
    }

    match /eventos/{id} {
      allow read: if hasRole();
      allow create: if (isStaff() || isAgent())
        && createsAsSelf()
        && validEventRecord(request.resource.data)
        && request.resource.data.responsibleId.size() > 0
        && (isStaff() || request.resource.data.responsibleId == request.auth.uid);
      allow update: if (isStaff() && updatesAsSelf() && validEventRecord(request.resource.data))
        || (agentUpdate()
          && validEventRecord(request.resource.data)
          && request.resource.data.responsibleId == resource.data.responsibleId);
      allow delete: if isAdmin() || isSupervisor() || (isAgent() && ownsExisting());
    }

    match /actividad/{id} {
      allow read: if hasRole();
      allow create: if (isStaff() || isAgent())
        && createsAsSelf()
        && (!isTaskRecord(request.resource.data)
          || (validTaskRecord(request.resource.data)
            && (isStaff() || request.resource.data.responsibleId == request.auth.uid)));
      allow update: if (isStaff()
          && updatesAsSelf()
          && (!isTaskRecord(resource.data)
            || (isTaskRecord(request.resource.data)
              && validTaskRecord(request.resource.data)
              && taskHistoryIsPreserved())))
        || assignedAgentTaskUpdate()
        || (!isTaskRecord(resource.data)
          && agentUpdate()
          && request.resource.data.get('recordType', '') == resource.data.get('recordType', ''));
      allow delete: if isAdmin();
    }

    match /reportes/{id} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin();
      allow create: if hasRole() && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == role();
      allow update: if isAdmin()
        || (hasRole() && uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == role());
      allow delete: if isAdmin();
    }

    match /condominios/{id} {
      allow read: if hasRole();

      allow create: if (
          isAdmin()
          && createsAsSelf()
          && request.resource.data.createdByRole == role()
          && request.resource.data.status in ['Activa', 'Inactiva']
          && assignedUserExists()
        ) || (
          isAgent()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.assignedTo == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.status in ['Activa', 'Inactiva']
          && request.resource.data.createdByRole == role()
        );

      allow update: if (
          isAdmin()
          && assignedUserExists()
          && updatesAsSelf()
        ) || (
          isAgent()
          && resource.data.assignedTo == request.auth.uid
          && (
            resource.data.createdBy == request.auth.uid
            || createdByStaff()
          )
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.createdBy == resource.data.createdBy
          && (
            !request.resource.data.keys().hasAny(['status'])
            || request.resource.data.status in ['Activa', 'Inactiva']
          )
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['assignedTo', 'assignedToName', 'assignedToEmail', 'createdBy'])
          && updatesAsSelf()
        );

      allow delete: if isAdmin()
        || (
          isAgent()
          && resource.data.assignedTo == request.auth.uid
          && resource.data.createdBy == request.auth.uid
        );
    }

    match /condominios/{id}/historial/{entryId} {
      allow read: if isAdmin()
        || ((isSupervisor() || isAgent())
          && get(/databases/$(database)/documents/condominios/$(id)).data.assignedTo == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.changedBy == request.auth.uid;
      allow update, delete: if false;
    }
    
    match /mapa_marcadores/{id} {
      allow read: if hasRole();
      allow create, update, delete: if false;
    }


    match /{document=**} {
      allow read, write: if false;
    }
  }
}
