rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : null;
    }

    function isAdmin() { return role() == 'ADMIN'; }
    function isSupervisor() { return role() == 'SUPERVISOR'; }
    function isAgent() { return role() == 'AGENTE'; }
    function isStaff() { return isAdmin() || isSupervisor(); }
    function hasRole() { return isAdmin() || isSupervisor() || isAgent(); }
    function ownsExisting() {
      return resource.data.createdBy == request.auth.uid;
    }
    function createsAsSelf() {
      return request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function updatesAsSelf() {
      return request.resource.data.updatedBy == request.auth.uid;
    }
    function agentUpdate() {
      return isAgent()
        && ownsExisting()
        && updatesAsSelf()
        && request.resource.data.createdBy == resource.data.createdBy;
    }
    function assignedUserExists() {
      return request.resource.data.assignedTo is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.assignedTo))
        && get(/databases/$(database)/documents/users/$(request.resource.data.assignedTo)).data.role in ['ADMIN', 'SUPERVISOR', 'AGENTE'];
    }
    function createdByStaff() {
      return exists(/databases/$(database)/documents/users/$(resource.data.createdBy))
        && get(/databases/$(database)/documents/users/$(resource.data.createdBy)).data.role in ['ADMIN', 'SUPERVISOR'];
    }
    match /inmobiliarios/{id} {
      allow read: if hasRole();
      allow create, update, delete: if isAdmin();
    }

    match /propiedades/{id} {
      allow read: if hasRole();
      allow create: if (isStaff() || isAgent()) && createsAsSelf();
      allow update: if isStaff() && updatesAsSelf() || agentUpdate();
      allow delete: if isAdmin();
    }

    match /clientes/{id} {
      allow read: if hasRole();
      allow create: if (isStaff() || isAgent()) && createsAsSelf();
      allow update: if isStaff() && updatesAsSelf() || agentUpdate();
      allow delete: if isAdmin();
    }

    match /eventos/{id} {
      allow read: if hasRole();
      allow create: if (isStaff() || isAgent()) && createsAsSelf();
      allow update: if isStaff() && updatesAsSelf() || agentUpdate();
      allow delete: if isAdmin() || isSupervisor() || (isAgent() && ownsExisting());
    }

    match /actividad/{id} {
      allow read: if hasRole();
      allow create: if (isStaff() || isAgent()) && createsAsSelf();
      allow update: if isStaff() && updatesAsSelf() || agentUpdate();
      allow delete: if isAdmin();
    }

    match /reportes/{id} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin();
      allow create: if hasRole() && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == role();
      allow update: if isAdmin()
        || (hasRole() && uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == role());
      allow delete: if isAdmin();
    }

    match /condominios/{id} {
      allow read: if hasRole();
      allow create: if isAdmin()
        && createsAsSelf()
        && request.resource.data.createdByRole == role()
        && request.resource.data.status in ['Activa', 'Inactiva']
        && assignedUserExists()
        || (isAgent()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.assignedTo == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.status in ['Activa', 'Inactiva']
          && request.resource.data.createdByRole == role());
      allow update: if isAdmin()
        && assignedUserExists()
        && updatesAsSelf()
        || (isAgent()
          && (resource.data.createdBy == request.auth.uid
            || (resource.data.assignedTo == request.auth.uid && createdByStaff()))
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.createdBy == resource.data.createdBy
          && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['Activa', 'Inactiva'])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedTo', 'assignedToName', 'assignedToEmail', 'createdBy'])
          && updatesAsSelf());
      allow delete: if isAdmin() || (isAgent() && resource.data.createdBy == request.auth.uid);
    }

    match /condominios/{id}/historial/{entryId} {
      allow read: if isAdmin()
        || ((isSupervisor() || isAgent())
          && get(/databases/$(database)/documents/condominios/$(id)).data.assignedTo == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.changedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
